   "source": [
    "### Loading the model\n",
    "\n",
    "We start with LLaMA-2-13B, a base (not instruction-tuned) model. The Geometry of Truth paper uses this model with `probe_layer=14` and `intervene_layer=8` - we'll use these exact values."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {
    "id": "cBkwe29f_rGR"
   },
   "outputs": [],
   "source": [
    "from huggingface_hub import login\n",
    "login()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {
    "id": "razDn5tN_rGS"
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "CPU mode: using cached activations in /Users/folusoogunlana/code/practice/ARENA/chapter1_transformer_interp/exercises/part31_linear_probes/activations/Llama-2-13b-hf\n",
      "Model: meta-llama/Llama-2-13b-hf\n",
      "Layers: 40, Hidden dim: 5120\n",
      "Probe layer: 14, Intervene layer: 8\n"
     ]
    }
   ],
   "source": [
    "MODEL_NAME = \"meta-llama/Llama-2-13b-hf\"\n",
    "PROBE_LAYER = 14\n",
    "INTERVENE_LAYER = 8\n",
    "\n",
    "# === Extract-on-GPU, analyse-on-CPU workflow (see GPU_WORKFLOW_PLAN.md) ===\n",
    "# Activations for the Geometry-of-Truth datasets were pre-extracted on a GPU with\n",
    "# extract_activations.py and cached to ./activations/<model>/<dataset>.pt, so Sections\n",
    "# 1-2 (PCA, probes, layer sweep, generalization) run locally on CPU with NO model in\n",
    "# memory. Flip USE_CACHED_ACTIVATIONS to False on a GPU box to load the live model.\n",
    "USE_CACHED_ACTIVATIONS = True\n",
    "ACT_DIR = section_dir / \"activations\" / MODEL_NAME.split(\"/\")[-1]\n",
    "\n",
    "if USE_CACHED_ACTIVATIONS:\n",
    "    assert ACT_DIR.exists(), f\"No cached activations at {ACT_DIR}. Run extract_activations.py on a GPU first.\"\n",
    "    manifest = json.loads((ACT_DIR / \"manifest.json\").read_text())\n",
    "    NUM_LAYERS = manifest[\"num_layers\"]\n",
    "    D_MODEL = manifest[\"d_model\"]\n",
    "    model = None\n",
    "    tokenizer = None\n",
    "    print(f\"CPU mode: using cached activations in {ACT_DIR}\")\n",
    "else:\n",
    "    tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\n",
    "    model = AutoModelForCausalLM.from_pretrained(\n",
    "        MODEL_NAME,\n",
    "        dtype=dtype,\n",
    "        device_map=\"auto\",\n",
    "    )\n",
    "    tokenizer.pad_token = tokenizer.eos_token\n",
    "    tokenizer.padding_side = \"right\"\n",
    "    NUM_LAYERS = len(model.model.layers)\n",
    "    D_MODEL = model.config.hidden_size\n",
    "\n",
    "# Probe/intervene layers from the geometry-of-truth config for llama-2-13b: truth\n",
    "# representations concentrate in early-to-mid layers (Section 3, \"group (b)\").\n",
    "print(f\"Model: {MODEL_NAME}\")\n",
    "print(f\"Layers: {NUM_LAYERS}, Hidden dim: {D_MODEL}\")\n",
    "print(f\"Probe layer: {PROBE_LAYER}, Intervene layer: {INTERVENE_LAYER}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Cached helpers ready: load_cached_activations(name[, layer]), cached_layer_sweep(name, layers)\n"
     ]
    }
   ],
   "source": [
    "# --- Cached-activation helpers (CPU workflow) ------------------------------------\n",
    "# Read the .pt files written by extract_activations.py. Used by the cells below when\n",
    "# USE_CACHED_ACTIVATIONS is True, so Sections 1-2 need no live model.\n",
    "\n",
    "def load_cached_activations(name: str, layer: int | None = None):\n",
    "    \"\"\"Load pre-extracted activations for one dataset from disk (CPU, float32).\n",
    "\n",
    "    Returns (acts, labels, statements). If `layer` is given, `acts` is a single\n",
    "    [n_statements, d_model] tensor for that layer; otherwise `acts` is the full\n",
    "    {layer: tensor} dict over all hidden-state layers (index 0 = embeddings).\n",
    "    \"\"\"\n",
    "    payload = t.load(ACT_DIR / f\"{name}.pt\", map_location=\"cpu\")\n",
    "    acts, labels, statements = payload[\"activations\"], payload[\"labels\"], payload[\"statements\"]\n",
    "    if layer is not None:\n",
    "        acts = acts[layer]\n",
    "    return acts, labels, statements\n",
    "\n",
    "\n",
    "def cached_layer_sweep(name: str, layers: list[int], train_frac: float = 0.8, seed: int = 42) -> dict[str, list[float]]:\n",
    "    \"\"\"Difference-of-means train/test accuracy per layer, from cached activations.\n",
    "\n",
    "    CPU stand-in for layer_sweep_accuracy(...): reads every layer from disk instead of\n",
    "    running a live model. Returns {\"train_acc\": [...], \"test_acc\": [...]}.\n",
    "    \"\"\"\n",
    "    acts, labels, _ = load_cached_activations(name)\n",
    "    t.manual_seed(seed)\n",
    "    n = labels.shape[0]\n",
    "    perm = t.randperm(n)\n",
    "    n_train = int(train_frac * n)\n",
    "    tr, te = perm[:n_train], perm[n_train:]\n",
    "    out = {\"train_acc\": [], \"test_acc\": []}\n",
    "    for L in layers:\n",
    "        X = acts[L]\n",
    "        Xtr, ytr, Xte, yte = X[tr], labels[tr], X[te], labels[te]\n",
    "        mu_t, mu_f = Xtr[ytr == 1].mean(0), Xtr[ytr == 0].mean(0)\n",
    "        direction = mu_t - mu_f\n",
    "        mid = (mu_t + mu_f) / 2\n",
    "        out[\"train_acc\"].append(((((Xtr - mid) @ direction) > 0).float() == ytr).float().mean().item())\n",
    "        out[\"test_acc\"].append(((((Xte - mid) @ direction) > 0).float() == yte).float().mean().item())\n",
    "    return out\n",
    "\n",
    "\n",
    "if USE_CACHED_ACTIVATIONS:\n",
    "    print(\"Cached helpers ready: load_cached_activations(name[, layer]), cached_layer_sweep(name, layers)\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "6q-DHbCY_rGS"
   },
   "source": [
    "### Loading the datasets\n",
    "\n",
    "The Geometry of Truth paper uses several carefully curated datasets of simple true/false statements. Each dataset has a `statement` column and a `label` column (1=true, 0=false).\n",
    "\n",
    "From the paper:\n",
    "> *\"We find that the truth-related structure in LLM representations is much cleaner for our curated datasets than for our unstructured ones.\"*\n",
    "\n",
    "Let's load three of these curated datasets and examine them:"
   ]
  },
